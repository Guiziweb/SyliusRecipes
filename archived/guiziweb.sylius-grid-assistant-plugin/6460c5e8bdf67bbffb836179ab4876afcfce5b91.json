{
    "manifests": {
        "guiziweb/sylius-grid-assistant-plugin": {
            "manifest": {
                "bundles": {
                    "Guiziweb\\SyliusGridAssistantPlugin\\GuiziwebSyliusGridAssistantPlugin": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  <bg=blue;fg=white>                                                              </>",
                    "  <bg=blue;fg=white>  Guiziweb SyliusGridAssistantPlugin installed!               </>",
                    "  <bg=blue;fg=white>                                                              </>",
                    "",
                    "  To enable the AI assistant, complete the setup in 3 steps:",
                    "",
                    "  <comment>1. Install Symfony AI bundle and a provider bridge</>",
                    "",
                    "     <comment>composer require symfony/ai-bundle symfony/ai-open-ai-platform</>",
                    "",
                    "     Other bridges available: symfony/ai-gemini-platform,",
                    "     symfony/ai-anthropic-platform, symfony/ai-mistral-platform.",
                    "",
                    "  <comment>2. Configure your provider in config/packages/ai.yaml</>",
                    "",
                    "     <comment>ai:",
                    "         platform:",
                    "             openai:",
                    "                 api_key: '%env(OPENAI_API_KEY)%'</>",
                    "",
                    "     Then add the key to <comment>.env.local</>:",
                    "",
                    "     <comment>OPENAI_API_KEY=sk-...</>",
                    "",
                    "  <comment>3. Enable the assistant on the grids you want</>",
                    "",
                    "     Edit <comment>config/packages/guiziweb_sylius_grid_assistant.yaml</>",
                    "     and add the grid codes under <comment>enabled_grids</>."
                ]
            },
            "files": {
                "config/packages/guiziweb_sylius_grid_assistant.yaml": {
                    "contents": [
                        "imports:",
                        "    - { resource: \"@GuiziwebSyliusGridAssistantPlugin/config/config.yaml\" }",
                        "",
                        "guiziweb_sylius_grid_assistant:",
                        "    enabled_grids:",
                        "        # List the grid codes where the AI assistant should appear.",
                        "        # Examples:",
                        "        # - sylius_admin_order",
                        "        # - sylius_admin_product",
                        "        # - sylius_admin_customer"
                    ],
                    "executable": false
                }
            },
            "ref": "6460c5e8bdf67bbffb836179ab4876afcfce5b91"
        }
    }
}
