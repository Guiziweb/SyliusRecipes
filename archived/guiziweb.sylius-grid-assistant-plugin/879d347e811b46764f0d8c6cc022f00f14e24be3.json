{
    "manifests": {
        "guiziweb/sylius-grid-assistant-plugin": {
            "manifest": {
                "bundles": {
                    "Guiziweb\\SyliusGridAssistantPlugin\\GuiziwebSyliusGridAssistantPlugin": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  <bg=blue;fg=white>                                                    </>",
                    "  <bg=blue;fg=white>  Guiziweb SyliusGridAssistantPlugin installed!     </>",
                    "  <bg=blue;fg=white>                                                    </>",
                    "",
                    "  Add your API key in <comment>.env.local</>:",
                    "     <comment>GEMINI_API_KEY=your_api_key_here</>",
                    "",
                    "  To use a different AI provider, edit <comment>config/packages/guiziweb_grid_assistant.yaml</>",
                    "  and uncomment the desired platform (OpenAI, Anthropic).",
                    "",
                    "  Get a free Gemini API key at <comment>https://aistudio.google.com/</>"
                ]
            },
            "files": {
                ".env": {
                    "contents": [
                        "###> guiziweb/sylius-grid-assistant-plugin ###",
                        "GEMINI_API_KEY=your_gemini_api_key_here",
                        "# OPENAI_API_KEY=your_openai_api_key_here",
                        "# ANTHROPIC_API_KEY=your_anthropic_api_key_here",
                        "###< guiziweb/sylius-grid-assistant-plugin ###"
                    ],
                    "executable": false
                },
                "config/packages/guiziweb_grid_assistant.yaml": {
                    "contents": [
                        "ai:",
                        "    platform:",
                        "        gemini:",
                        "            api_key: '%env(GEMINI_API_KEY)%'",
                        "        # openai:",
                        "        #     api_key: '%env(OPENAI_API_KEY)%'",
                        "        # anthropic:",
                        "        #     api_key: '%env(ANTHROPIC_API_KEY)%'",
                        "    agent:",
                        "        grid_assistant:",
                        "            platform: ai.platform.gemini",
                        "            model: gemini-2.0-flash",
                        "            # platform: ai.platform.openai",
                        "            # model: gpt-4o-mini",
                        "            # platform: ai.platform.anthropic",
                        "            # model: claude-3-5-haiku-20241022",
                        "            tools:",
                        "                services:",
                        "                    - Guiziweb\\SyliusGridAssistantPlugin\\Tool\\FilterGridTool"
                    ],
                    "executable": false
                },
                "config/routes/guiziweb_grid_assistant.yaml": {
                    "contents": [
                        "guiziweb_grid_assistant:",
                        "    resource: \"@GuiziwebSyliusGridAssistantPlugin/config/routes.yaml\"",
                        "    prefix: /admin"
                    ],
                    "executable": false
                }
            },
            "ref": "879d347e811b46764f0d8c6cc022f00f14e24be3"
        }
    }
}
